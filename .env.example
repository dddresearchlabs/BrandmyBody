# BrandmyBody — copy to .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe TEST keys only (pk_test_ / sk_test_). Do not use live keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Test-mode signing secret (whsec_…). Endpoint: POST /api/webhooks/stripe
# Dashboard → Developers → Webhooks → Add destination (test mode). Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Site origin for magic-link redirects (local or production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that can Admin remove any live listing on /account.
ADMIN_EMAILS=

# Bearer token for GET /api/cron/close-listings (Vercel Cron).
CRON_SECRET=

# Resend (winner emails). Use beth.t@example.com until a domain is verified.
RESEND_API_KEY=
RESEND_FROM=
